Meta.DisplayName=Halo 3 Reclaimer (AMP3)
Meta.Description=Halo 3 dedicated server via Project Reclaimer (MCC), binaire Linux natif
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.Author=Shinynecrid, portage AMP3 par Hellm4n
Meta.URL=https://projectreclaimer.dev/
Meta.DisplayImageSource=steam:976730
Meta.EndpointURIFormat=
Meta.ConfigManifest=halo3-reclaimer-amp3config.json
Meta.MetaConfigManifest=halo3-reclaimer-amp3metaconfig.json
Meta.ConfigRoot=halo3-reclaimer-amp3.kvp
Meta.MinAMPVersion=2.8.0.10
Meta.SpecificDockerImage=cubecoders/amp3base:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=Le serveur est un binaire Linux natif depuis la 0.10 : aucun Wine ni Xvfb. Le conteneur evite d installer des bibliotheques sur l hote.
Meta.ExtraSetupStepsURI=https://discourse.cubecoders.com/t/halo-3-project-reclaimer-mod-server-guide/43523
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=True
Meta.ConfigVersion=4
Meta.ReleaseNotes=Portage AMP3 : telechargement du binaire resolu par script au lieu d un JSONPath a regex (refuse par le moteur), binaire Linux natif au lieu de l exe sous Wine, etape Wine supprimee.
Meta.BreakingReleaseNotes=
