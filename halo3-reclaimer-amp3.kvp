Meta.AppIsMultiIPAware=False
App.DisplayName=Halo 3 Reclaimer (AMP3)
App.RootDir=./halo3-reclaimer-amp3/
App.BaseDirectory=./halo3-reclaimer-amp3/
App.ExecutableWin=project-reclaimer-dedicated.exe
App.ExecutableLinux=project-reclaimer
App.WorkingDir=
App.LinuxCommandLineArgs=--server dedicated.toml
App.WindowsCommandLineArgs=dedicated
App.CommandLineArgs=
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=--{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitMethodWindows=OS_CLOSE
App.ExitString=
App.ExitTimeout=10
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[halo3-reclaimer-amp3ports.json]
App.PrimaryApplicationPortRef=GamePort
App.AdminPortRef=GamePort
App.MaxUsers=16
App.UseRandomAdminPassword=True
App.PersistRandomPassword=True
App.AdminMethod=SourceRCON
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.UpdateSources=@IncludeJson[halo3-reclaimer-amp3updates.json]
App.PreStartStages=@IncludeJson[halo3-reclaimer-amp3start.json]
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=True
App.RapidStartup=False
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RCONConnected
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^\[.*?\] Shell lifecycle event \d+: .*$
Console.AppReadyRegex=
Console.UserJoinRegex=^\[.*?\] (?<username>.+?) connected from (?<endpoint>\S+) \(player ID (?<userid>[0-9a-f]{64}), ping \d+ ms\)\.$
Console.UserLeaveRegex=^\[.*?\] (?!Community roster:)(?<username>.+?) left the server\.$
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.ServerInfoRegex=
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={"Kick": "kick {{userid}}", "Mute": "mute {{userid}}", "Unmute": "unmute {{userid}}", "Ban": "ban {{userid}}"}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
