App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all","SteamAppId":"1133870","ROOT":"{{$FullRootDir}}","PACKS_DIR":"{{PacksDir}}","INSTALL_RUNTIME":"{{InstallRuntime}}","SERVER_URL":"{{ServerZipUrl}}","SERVER_SHA256":"{{ServerZipSha256}}","RUNTIME_URL":"{{RuntimeZipUrl}}","RUNTIME_SHA256":"{{RuntimeZipSha256}}","SE2_SESSION_NAME":"{{SessionName}}","SE2_MAX_PLAYERS":"{{MaxPlayers}}","SE2_PASSWORD":"{{ServerPassword}}","SE2_ADVERTISE":"{{Advertise}}","SE2_PVP":"{{Pvp}}","SE2_WORLD_NAME":"{{WorldName}}","SE2_MOTD":"{{Motd}}","SE2_AUTOSAVE":"{{EnableAutosave}}","SE2_SAVE_INTERVAL":"{{SaveIntervalSeconds}}","SE2_SHUTDOWN_COUNTDOWN":"{{ShutdownCountdownSeconds}}","SE2_RCON_ENABLED":"{{RconEnabled}}","SE2_RCON_PASSWORD":"{{RconPassword}}","SE2_RCON_PORT":"{{$RconPort}}","SE2_LISTEN_PORT":"{{$ServerPort}}","SE2_STREAMING_RADIUS":"{{StreamingRadiusMeters}}"}
