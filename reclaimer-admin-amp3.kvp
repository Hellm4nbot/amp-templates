Meta.MinAMPVersion=2.8.0.10
Meta.SpecificDockerImage=cubecoders/amp3base:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=Le serveur est un binaire Linux natif depuis la 0.10 : aucun Wine ni Xvfb. Le conteneur evite d installer des bibliotheques sur l hote.
Meta.ExtraSetupStepsURI=https://discourse.cubecoders.com/t/halo-3-project-reclaimer-mod-server-guide/43523
