Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=True
Meta.ConfigVersion=1
Meta.ReleaseNotes=Template d administration : tous les reglages documentes du serveur dedie, quatre modes de jeu, verification par dedicated check au demarrage, empreinte SHA256 de la release et version epinglable.
