Meta.DisplayName=Coodsz Coop Server Tool (interface graphique)
Meta.Description=Outil Coodsz Coop and Friends dans son interface WPF d'origine, execute sous Wine et servi dans le navigateur par noVNC. AMP pilote le conteneur : demarrage, arret, ports, limites et mises a jour. Les reglages de l'outil (mods, port du serveur, carte) restent dans sa fenetre, accessible depuis l'onglet du port noVNC, protegee par un mot de passe VNC. AMP fige le port hote a la creation de l'instance : le port de l'interface est 8642 par defaut, et s'il est deja pris sur la machine il faut changer le port HOTE dans l'onglet Ports (le conteneur garde le sien). Image : ghcr.io/hellm4nbot/coodsz-amp:amp3 (paquet prive, construite sur cubecoders/amp3base:debian).
Meta.ConfigVersion=8
Meta.MinAMPVersion=3.0.0.0
Meta.AppConfigId=8f2c61d4-3a75-4b19-9e04-5d71c8b6a2f0
Meta.SpecificDockerImage=ghcr.io/hellm4nbot/coodsz-amp:amp3
Meta.DisplayImageSource=steam:261550
App.RootDir=./coodszcoop/
App.BaseDirectory=./coodszcoop/data/
App.ExecutableLinux=coodszcoop-start.sh
App.LinuxCommandLineArgs=
App.CommandLineArgs=
App.WorkingDir=
App.ExitMethod=SIGTERM
App.ExitTimeout=30
App.EnvironmentVariables={"DISPLAY":":99","WINEPREFIX":"{{$FullRootDir}}.wine","WINEDEBUG":"-all","SteamAppId":"261550","COODSZ_VNC_PASSWORD":"{{VNCPassword}}","COODSZ_WEB_PORT":"8642","COODSZ_PUBLIC_HOST":"{{PublicAddress}}"}
App.Ports=@IncludeJson[coodszcoopports.json]
App.UpdateSources=@IncludeJson[coodszcoopupdates.json]
App.RunnableAsRoot=false
