Meta.DisplayName=RimWorld Multiplayer (RWMT)
Meta.Description=RimWorld Multiplayer (RWMT) standalone server. Native Linux .NET 8, PTY wrapper. Game settings appear under their own tab once the first player connects and uploads settings.toml.
Meta.OS=2
Meta.Arch=x86_64
Meta.AarchSupport=Unknown
Meta.Author=Hellm4n
Meta.URL=https://github.com/rwmt/Multiplayer
Meta.DisplayImageSource=steam:294100
Meta.EndpointURIFormat=
Meta.ConfigManifest=rwmtconfig.json
Meta.MetaConfigManifest=rwmtmetaconfig.json
Meta.ConfigRoot=rwmt.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=RecommendedOnLinux
Meta.ContainerPolicyReason=RWMT needs the .NET 8 runtime and the script utility to give the server a PTY, because its console loop calls Console.KeyAvailable which throws on a redirected pipe. The Debian container provides both.
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.ConfigVersion=6
Meta.NoCommercialUsage=False
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
Meta.AppConfigId=034f2983-3b2e-43c6-be4f-a6d52c79d52f
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
App.DisplayName=RimWorld Multiplayer (RWMT)
App.RootDir=./rwmt/
App.BaseDirectory=./rwmt/Server/Linux/
App.ExecutableLinux=Server/Linux/start.sh
App.ExecutableWin=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs={{CustomArgs}}
App.WorkingDir=Server/Linux
App.EnvironmentVariables={"DOTNET_ROOT":"{{$FullRootDir}}dotnet","DOTNET_SYSTEM_GLOBALIZATION_INVARIANT":"1","DOTNET_CLI_TELEMETRY_OPTOUT":"1","DOTNET_NOLOGO":"1"}
App.Ports=@IncludeJson[rwmtports.json]
App.ApplicationIPBinding=0.0.0.0
App.PrimaryApplicationPortRef=GamePort
App.MaxUsers=8
App.AdminMethod=STDIO
App.HasReadableConsole=True
App.HasWriteableConsole=True
App.UseLinuxIOREDIR=False
App.ExitMethod=SIGTERM
App.ExitTimeout=60
App.RapidStartup=False
App.UpdateSources=@IncludeJson[rwmtupdates.json]
App.PreStartStages=[]
App.ForceUpdate=False
App.ApplicationReadyMode=RegexMatch
App.SupportsLiveSettingsChanges=False
App.UseRandomAdminPassword=False
App.RemoteAdminPassword=
App.SteamUpdateAnonymousLogin=False
Console.AppReadyRegex=Bootstrap mode: 'settings\.toml' not found
Console.ThrowawayMessageRegex=^(WARNING|ERROR): Shader.+$
Console.UserJoinRegex=
Console.UserLeaveRegex=
Console.UserChatRegex=
Console.SuppressLogAtStart=False
Limits.SleepMode=False
Limits.SleepOnStart=False
